# ==========================================
# PulseChat Server Environment Configuration
# ==========================================

# Port (Cloud providers like Render / Railway set this automatically)
PORT=3001

# Secret key used for signing authentication JWT tokens (generate a long random string)
JWT_SECRET=your_super_secret_jwt_random_string_here_min_32_characters

# MongoDB Connection String:
# For production, create a free cluster on MongoDB Atlas (https://www.mongodb.com/cloud/atlas)
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/chatApp?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/chatApp

# Optional: Cloudinary Cloud Media Storage (Recommended for Production Hosting)
# When set, uploaded images, files, and voice notes are stored securely on Cloudinary CDN
# Get free credentials at: https://cloudinary.com
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=